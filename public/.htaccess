# Front-controller routing for Apache.
#
# The built-in PHP server forwards unknown paths to index.php on its own;
# Apache needs this rule. Without it the server answers /api/... with its own
# 404 and the application is never reached.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve existing files (style.css, app.js) directly.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Everything else is answered by the front controller.
    RewriteRule ^ index.php [L]
</IfModule>

<IfModule mod_dir.c>
    DirectoryIndex index.php
</IfModule>

# Never list directory contents.
<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set Referrer-Policy "same-origin"
</IfModule>

# Never serve dotfiles (.htaccess, .env, .git …).
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
