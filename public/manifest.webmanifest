{
  "name": "Coffee Time",
  "short_name": "Coffee Time",
  "description": "A shared office coffee tab with passkey sign-in and one-tap coffee tracking.",
  "id": "/", "start_url": "/", "scope": "/", "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary", "background_color": "#f6f1ea", "theme_color": "#7a4a21", "lang": "en",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-192.png", "sizes": "192x192", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "screenshots": [
    {
      "src": "/screenshots/mobile-home.png", "sizes": "780x1688", "type": "image/png",
      "form_factor": "narrow",
      "label": "Your coffee tally with the one-tap booking button, the 14-day history and the anonymous leaderboard"
    },
    {
      "src": "/screenshots/desktop-home.png", "sizes": "2560x1600", "type": "image/png",
      "form_factor": "wide",
      "label": "Coffee Time on the desktop: tally, outstanding balance, 14-day history and the anonymous leaderboard"
    }
  ],
  "shortcuts": [{
    "name": "Book a coffee", "short_name": "Coffee",
    "description": "Books a coffee immediately. The same URL can be stored on an NFC tag.",
