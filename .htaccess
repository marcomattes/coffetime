# This file only takes effect when the document root points at the project
# directory instead of public/ — often unavoidable on simple shared hosting.
# It then routes every request into public/; config.php, src/, tools/,
# tests/, vendor/, and data/ become unreachable over HTTP because any request
# for them ends in the front controller (JSON 404).
#
# When the document root correctly points at public/, Apache never reads this
# file — it sits above the root and has no effect.

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Serve static files from public/.
    RewriteCond %{DOCUMENT_ROOT}/public/$1 -f
    RewriteRule ^(.+)$ public/$1 [L]

    # Everything else goes to the front controller.
    RewriteRule ^ public/index.php [L]
</IfModule>

<IfModule mod_autoindex.c>
    Options -Indexes
</IfModule>

# Never serve dotfiles (.htaccess, .env, .git …).
<FilesMatch "^\.">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
